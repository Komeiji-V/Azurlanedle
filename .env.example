# 复制成项目根目录的 .env 即可覆盖 docker compose 的默认值（.env 不会入库）
# 详细说明见 docker-compose.yml 的 build.args

# 宿主机端口，默认 8080
AZURLANEDLE_PORT=8080

# npm 源，国内建议用镜像（默认留空走官方源）
NPM_REGISTRY=https://registry.npmmirror.com

# 「更新中心」的远端检查地址，全部留空则只显示本地版本、不发任何网络请求
NEXT_PUBLIC_AZURLANEDLE_REPO_URL=
NEXT_PUBLIC_AZURLANEDLE_VERSION_URL=
NEXT_PUBLIC_AZURLANEDLE_DB_URL=
NEXT_PUBLIC_AZURLANEDLE_DB_RAW_URL=
